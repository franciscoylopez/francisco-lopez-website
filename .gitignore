# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# archivos de trabajo desechables (scripts de un rato, previews de QA, borradores).
# Lo que merezca conservarse sale de aqui a scripts/ o docs/ - ver scripts/logos/.
/scratch

# Instantáneas del gate de refactor (scripts/page-html-diff.ts).
# No se versionan: son una línea base de UN refactor concreto, y cualquier cambio
# de copy las invalida a propósito. El script sí, las fotos no.
/scripts/.html-baseline
/scripts/.html-actual

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo la plantilla de ejemplo, que sí se versiona (documenta las vars).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — config local de máquina (las skills del proyecto SÍ se versionan)
.claude/settings.local.json
