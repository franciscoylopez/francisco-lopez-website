# Variables de entorno del proyecto. Copia este archivo a `.env.local` para
# desarrollo, o configúralas en el panel de Vercel para preview/producción.
# Ninguna es secreta (todas son públicas por diseño), pero se documentan aquí.

# URL base del sitio — override manual de la resolución automática (lib/site.ts).
# En Vercel no hace falta: se deriva de VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL
# (D15). Útil solo si quieres forzar un host concreto en local.
# NEXT_PUBLIC_SITE_URL=https://franciscolopez.es

# Google Tag Manager (P21) — ID del contenedor, formato GTM-XXXXXXX.
# El contenedor solo se carga en PRODUCCIÓN (VERCEL_ENV=production) y si esta var
# está definida (lib/site.ts → GTM_ID). En dev/preview no corre, para no ensuciar
# los datos (D13). Configúrala en Vercel, entorno Production.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
